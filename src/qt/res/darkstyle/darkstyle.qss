QWidget {
  background-color: #000000;
  color: #ffffff;
  selection-background-color: #ffffff;
  selection-color: #000000;
}
QToolTip {
  color: #000000;
  background-color: #ffffff;
  border: 1px solid #ffffff;
  border-radius: 0px;
}
QStatusBar {
  background-color: #000000;
  color: #b0b0b0;
  border-top: 1px solid #ffffff;
}
QMenuBar {
  background-color: #000000;
  border-bottom: 1px solid #ffffff;
  color: #ffffff;
}
QMenuBar::item {
  spacing: 4px;
  padding: 6px 10px;
  background: transparent;
}
QMenuBar::item:selected {
  background-color: #ffffff;
  color: #000000;
}
QMenuBar::item:pressed {
  background-color: #ffffff;
  color: #000000;
}
QMenu {
  background-color: #000000;
  border: 1px solid #ffffff;
  color: #ffffff;
}
QMenu::item {
  padding: 6px 24px;
  border: none;
}
QMenu::item:disabled {
  color: #666666;
}
QMenu::item:selected {
  background: #ffffff;
  color: #000000;
}
QMenu::separator {
  height: 1px;
  background: #ffffff;
  margin: 4px 8px;
}
QToolBar {
  background-color: #000000;
  border: none;
  spacing: 0px;
}
QMainWindow::separator {
  width: 1px;
  height: 1px;
  background: #ffffff;
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
  background-color: #0a0a0a;
  color: #ffffff;
  border: 1px solid #555555;
  border-radius: 0px;
  padding: 4px;
  selection-background-color: #ffffff;
  selection-color: #000000;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 1px solid #ffffff;
}
QPushButton {
  background-color: #000000;
  color: #ffffff;
  border: 1px solid #ffffff;
  border-radius: 0px;
  padding: 6px 14px;
  min-height: 18px;
}
QPushButton:hover {
  background-color: #ffffff;
  color: #000000;
}
QPushButton:pressed {
  background-color: #d0d0d0;
  color: #000000;
}
QPushButton:disabled {
  color: #666666;
  border-color: #333333;
}
QTabBar::tab {
  background: #000000;
  color: #8a8a8a;
  border: 1px solid #333333;
  padding: 8px 16px;
}
QTabBar::tab:selected {
  background: #000000;
  color: #ffffff;
  border-bottom: 2px solid #ffffff;
}
QTabWidget::pane {
  border: 1px solid #333333;
}
QHeaderView::section {
  background-color: #000000;
  color: #ffffff;
  border: none;
  border-bottom: 1px solid #ffffff;
  padding: 6px;
}
QTableView, QTreeView, QListView {
  background-color: #000000;
  alternate-background-color: #111111;
  color: #ffffff;
  border: none;
  outline: 0;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background: #ffffff;
  color: #000000;
}
QScrollBar:vertical {
  background: #000000;
  width: 10px;
  margin: 0;
}
QScrollBar::handle:vertical {
  background: #ffffff;
  min-height: 20px;
}
QScrollBar:horizontal {
  background: #000000;
  height: 10px;
}
QScrollBar::handle:horizontal {
  background: #ffffff;
  min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0;
  width: 0;
}
QCheckBox, QRadioButton {
  color: #ffffff;
  spacing: 8px;
}
QGroupBox {
  border: 1px solid #333333;
  margin-top: 12px;
  color: #ffffff;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 8px;
  padding: 0 4px;
  color: #ffffff;
}
QProgressBar {
  border: 1px solid #ffffff;
  background: #000000;
  color: #ffffff;
  text-align: center;
}
QProgressBar::chunk {
  background: #ffffff;
}
QLabel {
  color: #ffffff;
}
